# OrcaRouter (OpenAI互換API) 接続設定
# .env.local を作成してこの内容をコピーし、値を設定してください。
# .env / .env.local は Git 管理対象外です（.gitignore 参照）。

# 必須: OrcaRouterのAPIキー
ORCAROUTER_API_KEY=

# 任意: OrcaRouterのBase URL（未設定時は https://api.orcarouter.ai/v1 を使用）
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# 任意: 使用するモデル/ルーターID（未設定時は orcarouter/auto を使用）
# Web Searchの実発火を確認したモデル/ルートに切り替えることを推奨します。
# 例: openai/gpt-4o-mini-search-preview は実検索(url_citation)の発火を確認済み。
ORCAROUTER_MODEL=orcarouter/auto

# 任意: OrcaRouter呼び出しのタイムアウト（ミリ秒、未設定時は55000）
ORCAROUTER_TIMEOUT_MS=55000

# 任意: Web Search を有効化する場合 true（未設定時は false）。
# response_format と web_search_options の併用が確認できたモデルでのみ有効にしてください。
ORCAROUTER_WEB_SEARCH=false
