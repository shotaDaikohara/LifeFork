# OrcaRouter (OpenAI互換API) 接続設定
# .env.local を作成してこの内容をコピーし、値を設定してください。
# .env / .env.local は Git 管理対象外です（.gitignore 参照）。

# 必須: OrcaRouterのAPIキー
ORCAROUTER_API_KEY=

# 任意: OrcaRouterのBase URL（未設定時は https://api.orcarouter.ai/v1 を使用）
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# 任意: 詳細生成 (Pass2: ResearchResult / InterviewResponse) に使うモデル/ルーターID
# （未設定時は orcarouter/auto を使用）。3道比較を含む大きなJSONを生成するため、
# 出力トークン上限に余裕がある通常モデルを推奨します。
# 例: openai/gpt-4o-mini は動作確認済み（Pass2のみで約50秒）。
ORCAROUTER_MODEL=orcarouter/auto

# 任意: 基礎調査 (Pass1) に使うWeb Search対応モデル。未設定時は基礎調査自体をスキップします。
# 注意: gpt-4o-*-search-preview / gpt-5-search-api 系は出力トークンが実測1,000〜1,500程度に
# 制限されており、3道比較を含む大きなJSONを直接生成させると出力が途中で切れます。
# そのため Web Search はこの軽量な事実調査ステップのみで使用してください。
# 例: openai/gpt-4o-mini-search-preview は実検索(url_citation)の発火を確認済み。
ORCAROUTER_FACT_MODEL=openai/gpt-4o-mini-search-preview

# 任意: Pass2 (詳細生成) 呼び出しのタイムアウト（ミリ秒、未設定時は45000）
# gpt-4o-mini で3道比較を含むResearchResultを生成する場合、50〜65秒程度かかることがあります。
ORCAROUTER_TIMEOUT_MS=80000

# 任意: Pass1 (基礎調査) 呼び出しのタイムアウト（ミリ秒、未設定時は15000）
ORCAROUTER_FACT_TIMEOUT_MS=15000

# 任意: Pass1 (基礎調査) で Web Search を有効化する場合 true（未設定時は false）。
# ORCAROUTER_FACT_MODEL が response_format と web_search_options の併用に対応している場合のみ有効にしてください。
ORCAROUTER_WEB_SEARCH=true

# --- Google OIDC / Auth.js 認証設定 (設計書v0.4 14.1章) ---
# .env.local を作成してこの内容をコピーし、値を設定してください。
# GOOGLE_CLIENT_SECRET と AUTH_SECRET はVercelではSensitive Environment Variablesとして設定してください。

# 必須: Google Cloud ConsoleでOAuthクライアントを発行して設定
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (本番は https://<project>.vercel.app/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 必須: Auth.jsのセッション署名用シークレット。`npx auth secret` または `openssl rand -base64 32` で生成
AUTH_SECRET=

# 必須: ログインを許可するGoogleアカウントのメールアドレス（カンマ区切り、サーバー側のみ参照）
ALLOWED_EMAILS=user1@gmail.com,user2@gmail.com

# 任意: /api/interview + /api/research をまとめて保護するユーザー単位Rate Limitの上限（回/分、未設定時は10）
RATE_LIMIT_PER_MINUTE=10
